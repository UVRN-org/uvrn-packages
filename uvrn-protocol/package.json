{
  "name": "@uvrn/protocol",
  "version": "4.0.0",
  "description": "Single-install UVRN convenience package: re-exports the production research path (core + receipt + measure + consensus + normalize + score + algox + signal)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "clean": "rm -rf dist",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@uvrn/algox": "workspace:^",
    "@uvrn/consensus": "workspace:^",
    "@uvrn/core": "workspace:^",
    "@uvrn/measure": "workspace:^",
    "@uvrn/normalize": "workspace:^",
    "@uvrn/receipt": "workspace:^",
    "@uvrn/score": "workspace:^",
    "@uvrn/signal": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "uvrn",
    "protocol",
    "receipts",
    "verification"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UVRN-org/uvrn-packages.git",
    "directory": "uvrn-protocol"
  },
  "publishConfig": {
    "access": "public"
  }
