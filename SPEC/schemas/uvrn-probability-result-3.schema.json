    "utcOffset": {
      "type": "string",
      "pattern": "^(?!-00:00$)(?:\\+(?:0\\d|1[0-3]):[0-5]\\d|\\+14:00|-(?:0\\d|1[01]):[0-5]\\d|-12:00)$",
      "description": "Fixed UTC offset ±hh:mm for the deadline day (SPEC/uvrn-probability-v3.md §3.1): minutes 00–59, combined value -12:00 … +14:00, and -00:00 rejected (UTC is +00:00). Matches parseOffsetMinutes exactly (conformance-tested)."
    }
