        "scrape": "titles-unused"
      }
    },
    {
      "id": "FR07",
      "name": "future-F-excluded-from-observation-pool",
      "mess": "Future-period F forecasts must not pool with A observations (SPEC §6.1).",
      "claim": "Mixed observation + future forecast on FX",
      "sources": [
        {
          "url": "https://fixture.uvrn.example/FR07/obs",
          "title": "EURUSD print 1.08",
          "snippet": "Observed print.",
          "evidenceScore": 1.08,
          "obsStatus": "A",
          "measuredAt": "2026-08-01T00:00:00.000Z",
          "unit": "1",
          "quantityKind": "quantity"
        },
        {
          "url": "https://fixture.uvrn.example/FR07/fc",
          "title": "EURUSD rockets to 9.99 next week (tempting)",
          "snippet": "Forecast prose.",
          "evidenceScore": 1.09,
          "obsStatus": "F",
          "appliesTo": "2026-08-15T00:00:00.000Z",
          "unit": "1",
          "quantityKind": "quantity"
        }
      ],
      "expect": {
        "consensus": {
          "evalTime": "2026-08-06T00:00:00.000Z",
          "excludedForecastCount": 1,
          "observationSourceCount": 1
        },
        "scrape": "title-9.99-unused-under-scrape-off"
      }
    },
    {
      "id": "FR08",
      "name": "missing-unit-vs-declared-unit",
      "mess": "One desk declares UCUM; the other omits unit — scrape-off title must not invent the missing unit.",
      "claim": "Gold 10-day near 2400 USD",
      "sources": [
        {
          "url": "https://fixture.uvrn.example/FR08/a",
          "title": "Gold 9999 USD scream headline",
          "snippet": "No declared unit on this row.",
          "evidenceScore": 2390,
          "obsStatus": "F",
          "appliesTo": "2026-08-16T00:00:00.000Z",
          "quantityKind": "money"
        },
        {
          "url": "https://fixture.uvrn.example/FR08/b",
          "title": "Desk B typed gold",
          "snippet": "Host-declared.",
          "evidenceScore": 2410,
          "obsStatus": "F",
          "appliesTo": "2026-08-16T00:00:00.000Z",
          "quantityKind": "money",
          "unit": "[USD]"
        }
      ],
      "expect": {
        "consensus": "scrape-off-unusable-or-declared-only",
        "scrape": "title-9999-must-not-become-value-or-unit"
      }
