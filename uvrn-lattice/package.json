{
  "name": "@uvrn/lattice",
  "version": "0.4.1",
  "description": "Cross-domain evidence decomposition layer for the UVRN protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@uvrn/core": ">=1.0.0",
    "@uvrn/farm": ">=1.0.0",
    "@uvrn/normalize": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@uvrn/farm": {
      "optional": true
    },
    "@uvrn/normalize": {
      "optional": true
    }
  },
  "devDependencies": {
    "@uvrn/core": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "uvrn",
    "lattice",
    "evidence",
    "decomposition",
    "consensus"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UVRN-org/uvrn-packages.git",
    "directory": "uvrn-lattice"
  },
  "publishConfig": {
    "access": "public"
  }
}
