        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "statement": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "counterarguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/text"
        },
        "range": {
          "oneOf": [
            {
              "type": "null"
