{
  "name": "@uvrn/mcp",
  "version": "5.1.1",
  "description": "UVRN MCP server — 14 stdio tools for AI agents: Delta Engine runs, receipt checks, claim scoring, post-pipeline readouts, pattern scans, and receipted probability",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "uvrn-mcp": "dist/index.js"
  },
  "keywords": [
    "uvrn",
    "mcp",
    "verification",
    "receipt",
    "ai",
    "model-context-protocol",
    "probability"
  ],
  "author": "UVRN",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/UVRN-org/uvrn-packages.git",
    "directory": "uvrn-mcp"
  },
  "homepage": "https://github.com/UVRN-org/uvrn-packages/tree/main/uvrn-mcp#readme",
  "bugs": {
    "url": "https://github.com/UVRN-org/uvrn-packages/issues"
  },
  "scripts": {
    "build": "pnpm run clean && tsc --noEmit && dts-bundle-generator --config dts-bundle.config.cjs && node esbuild.config.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "node ../scripts/guard-pnpm-publish.mjs"
  },
  "peerDependencies": {
    "@uvrn/probability": "^0.1.0 || ^0.2.0 || ^0.3.0"
  },
  "peerDependenciesMeta": {
    "@uvrn/probability": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@uvrn/agent": "workspace:^",
    "@uvrn/algox": "workspace:^",
    "@uvrn/canon": "workspace:^",
    "@uvrn/compare": "workspace:^",
    "@uvrn/consensus": "workspace:^",
    "@uvrn/core": "workspace:^",
    "@uvrn/drift": "workspace:^",
    "@uvrn/identity": "workspace:^",
    "@uvrn/lattice": "workspace:^",
    "@uvrn/measure": "workspace:^",
    "@uvrn/normalize": "workspace:^",
    "@uvrn/pattern": "workspace:^",
    "@uvrn/probability": "workspace:^",
    "@uvrn/receipt": "workspace:^",
    "@uvrn/score": "workspace:^",
    "@uvrn/validate": "workspace:^",
    "@vitest/coverage-v8": "^1.6.1",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.20.2",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONNECT.md",
    "DISTRIBUTION.md",
    "ENVIRONMENT.md",
    "LICENSE",
    "NOTICE",
    "plugin-manifest.json",
    "connectors"
  ],
  "publishConfig": {
    "access": "public"
  }
}
