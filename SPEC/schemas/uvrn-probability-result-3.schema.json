              "$ref": "#/$defs/numbersOrNull"
            },
            "power": {
              "$ref": "#/$defs/numbersOrNull"
            },
            "shin": {
              "$ref": "#/$defs/numbersOrNull"
            },
            "powerK": {
              "$ref": "#/$defs/numberOrNull"
            },
