{
  "name": "@uvrn/store-sqlite",
  "version": "5.1.1",
  "description": "Zero-signup durable persistence for UVRN: every store interface implemented against a single local SQLite file, plus pushToNetwork() sync to the UVRN registry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./track-record": {
      "types": "./dist/track-record.d.ts",
      "default": "./dist/track-record.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "node ../scripts/guard-pnpm-publish.mjs"
  },
  "peerDependencies": {
    "@uvrn/agent": "^5.1.0",
    "@uvrn/canon": "^5.1.0",
    "@uvrn/core": "^5.1.0",
    "@uvrn/drift": "^5.1.0",
    "@uvrn/identity": "^5.1.0",
    "@uvrn/receipt": "^5.1.0",
    "@uvrn/timeline": "^5.1.0",
    "@uvrn/track-record": "^5.1.0",
    "@uvrn/watch": "^5.1.0",
    "better-sqlite3": "^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "@uvrn/agent": {
      "optional": true
    },
    "@uvrn/canon": {
      "optional": true
    },
    "@uvrn/drift": {
      "optional": true
    },
    "@uvrn/identity": {
      "optional": true
    },
    "@uvrn/timeline": {
      "optional": true
    },
    "@uvrn/track-record": {
      "optional": true
    },
    "@uvrn/watch": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@uvrn/agent": "workspace:^",
    "@uvrn/canon": "workspace:^",
    "@uvrn/core": "workspace:^",
    "@uvrn/drift": "workspace:^",
    "@uvrn/identity": "workspace:^",
    "@uvrn/receipt": "workspace:^",
    "@uvrn/timeline": "workspace:^",
    "@uvrn/track-record": "workspace:^",
    "@uvrn/watch": "workspace:^",
    "@types/better-sqlite3": "^7.6.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.10.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "uvrn",
    "sqlite",
    "persistence",
    "store",
    "receipts",
    "track-record",
    "forecast-log"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UVRN-org/uvrn-packages.git",
    "directory": "uvrn-store-sqlite"
  },
  "homepage": "https://github.com/UVRN-org/uvrn-packages/tree/main/uvrn-store-sqlite#readme",
  "bugs": {
    "url": "https://github.com/UVRN-org/uvrn-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "track-record": [
        "dist/track-record.d.ts"
      ]
    }
  }
}
