{
  "name": "@uvrn/store-sqlite",
  "version": "4.0.0",
  "description": "Zero-signup durable persistence for UVRN: every store interface implemented against a single local SQLite file, plus pushToNetwork() sync to the UVRN registry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@uvrn/agent": "^4.0.0",
    "@uvrn/canon": "^4.0.0",
    "@uvrn/core": "^4.0.0",
    "@uvrn/drift": "^4.0.0",
    "@uvrn/identity": "^4.0.0",
    "@uvrn/receipt": "^4.0.0",
    "@uvrn/timeline": "^4.0.0",
    "@uvrn/watch": "^4.0.0",
    "better-sqlite3": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@uvrn/agent": {
      "optional": true
    },
    "@uvrn/canon": {
      "optional": true
    },
    "@uvrn/drift": {
      "optional": true
    },
    "@uvrn/identity": {
      "optional": true
    },
    "@uvrn/timeline": {
      "optional": true
    },
    "@uvrn/watch": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@uvrn/agent": "workspace:*",
    "@uvrn/canon": "workspace:*",
    "@uvrn/core": "workspace:*",
    "@uvrn/drift": "workspace:*",
    "@uvrn/identity": "workspace:*",
    "@uvrn/receipt": "workspace:*",
    "@uvrn/timeline": "workspace:*",
    "@uvrn/watch": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^11.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "uvrn",
    "sqlite",
    "persistence",
    "store",
    "receipts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UVRN-org/uvrn-packages.git",
    "directory": "uvrn-store-sqlite"
  },
  "publishConfig": {
    "access": "public"
  }
}
