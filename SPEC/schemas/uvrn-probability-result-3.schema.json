            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "low",
                "high",
                "rationale"
              ],
              "properties": {
                "low": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "high": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rationale": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          ]
        }
      },
      "if": {
        "properties": {
          "basisLabel": {
            "const": "assumption-only"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          },
          "assumptions": {
            "minItems": 1
          }
