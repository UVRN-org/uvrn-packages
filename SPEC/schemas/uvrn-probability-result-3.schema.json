        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "source"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
