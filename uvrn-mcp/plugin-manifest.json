{
  "name": "uvrn-mcp",
  "displayName": "UVRN MCP",
  "version": "4.0.1",
  "description": "Client-neutral MCP access to UVRN verification, drift, compare, canon-read, live score-claim, post-pipeline support/rank-stability, and pattern-scan observatory tools.",
  "transport": {
    "type": "stdio",
    "command": "node",
    "args": ["dist/index.js"]
  },
  "capabilities": {
    "tools": [
      "delta_run_engine",
      "delta_validate_bundle",
      "delta_verify_receipt",
      "delta_score_drift",
      "delta_compare",
      "delta_verify_identity",
      "delta_canon_qualify",
      "delta_canon_get",
      "delta_score_claim",
      "delta_read_support",
      "delta_report_rank_stability",
      "delta_validate_datapoint",
      "delta_pattern_scan"
    ],
    "resources": [
      "mcp://delta-engine/schema/bundle",
      "mcp://delta-engine/schema/receipt",
      "mcp://delta-engine/receipts/{uvrn}",
      "mcp://delta-engine/bundles/{id}"
    ],
    "prompts": ["verify_data", "create_bundle", "analyze_receipt"]
  },
  "configuration": {
    "runtimeConfig": {
      "description": "Optional injected stores, signers, identity store, and farm connectors. Omitted values use zero-external mock defaults where applicable."
    },
    "environment": ["LOG_LEVEL", "MAX_BUNDLE_SIZE", "VERBOSE_ERRORS", "STORAGE_PATH"]
  }
}
