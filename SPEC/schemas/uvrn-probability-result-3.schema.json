      "if": {
        "properties": {
          "kind": {
            "const": "sportsbook"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "exchange"
          ]
        },
        "properties": {
          "outcomes": {
            "minItems": 2,
            "items": {
              "required": [
                "odds"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "bid"
                    ]
                  },
                  {
                    "required": [
                      "ask"
                    ]
                  },
                  {
                    "required": [
                      "mid"
                    ]
                  },
                  {
                    "required": [
                      "depthUsd"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "sportsbook"
          ]
        },
        "properties": {
          "outcomes": {
            "items": {
              "required": [
                "bid",
                "ask",
                "depthUsd"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "odds"
                    ]
                  },
                  {
                    "required": [
                      "impliedP"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
